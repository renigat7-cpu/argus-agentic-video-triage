# Argus configuration. Copy to .env and fill in. Never commit real keys.

# Where decision logs and evidence bundles are written.
ARGUS_OUT_DIR=./var

# Reasoner backend: "heuristic" (reproducible, default), "llm" (OpenAI-compatible
# tool calling) or "bedrock" (AWS Bedrock Converse tool loop).
ARGUS_REASONER=heuristic

# Optional LLM backend (OpenAI-compatible). Required only for ARGUS_REASONER=llm.
ARGUS_LLM_BASE_URL=
ARGUS_LLM_MODEL=gpt-4o-mini
ARGUS_LLM_KEY=

# Optional AWS Bedrock backend. Required only for ARGUS_REASONER=bedrock.
# Needs `pip install "argus-triage[aws]"` or boto3 on the path.
ARGUS_BEDROCK_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0
ARGUS_BEDROCK_REGION=

# Hard cap on model <-> tool round trips per clip (both LLM and Bedrock loops).
ARGUS_AGENT_MAX_STEPS=5

# Mirror decisions to S3 + CloudWatch. Off by default; never a hard dependency.
ARGUS_AWS_SINK=0
ARGUS_AWS_REGION=
ARGUS_S3_BUCKET=
ARGUS_S3_PREFIX=decisions/
ARGUS_CW_NAMESPACE=Argus

# Optional JSON config overriding thresholds in src/argus/config.py.
ARGUS_CONFIG=./config/argus.json

# Upload staging directory for the web endpoint.
ARGUS_UPLOAD_DIR=./var/uploads
